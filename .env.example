# ============================================================================
# EvalAI — environment configuration (placeholders only; never commit real .env)
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase (project settings → API)
# ----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Public anon key — safe for the frontend (VITE_SUPABASE_ANON_KEY must match).
SUPABASE_ANON_KEY=your-anon-key
# Service role key — BACKEND ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Legacy HS256 projects: the `jwt_secret` shown in Supabase API settings.
# Projects migrated to asymmetric keys may leave this empty (JWKS is used).
SUPABASE_JWT_SECRET=

# Direct Postgres connection for the backend (Project settings → Database).
# Use the pooler URL on port 6543 for serverless-style workloads:
#   postgresql://postgres.PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-ref.supabase.co:5432/postgres

# ----------------------------------------------------------------------------
# Resend (authentication email via Supabase custom SMTP, or app notifications)
# SMTP credentials come from your Resend domain/smtp setup and are entered in
# the Supabase dashboard (Authentication → SMTP), not here. RESEND_API_KEY is
# only needed if application-level email is enabled later.
# ----------------------------------------------------------------------------
RESEND_API_KEY=re_placeholder
EMAIL_FROM="EvalAI <no-reply@yourdomain.example>"

# ----------------------------------------------------------------------------
# API server
# ----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8300
# Comma-separated CORS origins allowed to call the API.
API_ALLOWED_ORIGINS=http://localhost:3000
# Shared token workers use to register/claim/submit (hashed in worker_nodes).
WORKER_TOKEN=change-me-worker-token

# ----------------------------------------------------------------------------
# Frontend (Vite) — public values only
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Base URL of the FastAPI backend (empty = same-origin /api proxy in dev).
VITE_API_BASE_URL=

# ----------------------------------------------------------------------------
# AI provider / perception stack (existing configuration)
# ----------------------------------------------------------------------------
AI_PROVIDER=ollama

# Ollama OpenAI-Compatible API Configuration
OLLAMA_BASE_URL=http://localhost:11434/v1
VISION_MODEL=qwen3-vl:4b
OLLAMA_API_KEY=ollama
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=2

# Ollama OCR inference (settings: `ocr:` section in config/settings.yaml)
OLLAMA_OCR_MODEL=qwen3-vl:4b
OLLAMA_OCR_NUM_CTX=16384
OLLAMA_OCR_NUM_PREDICT=4096
OLLAMA_OCR_TEMPERATURE=0

# Legacy OCR knobs (still honored; OLLAMA_OCR_* above takes precedence):
# OCR_THINKING=false
# OCR_MAX_ATTEMPTS=2
# OCR_MIN_VALID_CHARS=2

# Optional Port 8090 Configuration:
# OLLAMA_BASE_URL=http://localhost:8090/v1

# Logging & Environment
LOG_LEVEL=INFO
MODEL_PROFILE=qwen3_vl_4b

# Jobs / workflow infrastructure
# REDIS_URL=redis://localhost:6379/0
# WORKFLOW_CHECKPOINT_DB=data/workflow_checkpoints.db

# Local object storage root (StorageProvider=default local dev provider)
STORAGE_LOCAL_ROOT=data/storage
